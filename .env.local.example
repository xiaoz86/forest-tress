# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# New Member Email Notification (optional)
# If RESEND_API_KEY is not set, email notifications are silently skipped.
# Sign up at https://resend.com to get a free API key.
RESEND_API_KEY=

# Comma-separated list of recipients. Defaults to 1826741794@qq.com if unset.
# Example: NOTIFY_EMAILS=host1@qq.com,host2@gmail.com
NOTIFY_EMAILS=

# Sender identity. Must be a verified domain in Resend, OR use the default
# 'onboarding@resend.dev' (only works for sending to yourself in the Resend account email).
# After verifying nearby-forest.club in Resend, switch to e.g.:
# NOTIFY_FROM=附近森林 <noreply@nearby-forest.club>
NOTIFY_FROM=

# Kimi (Moonshot) AI 匹配（可选）
# 用于把规则匹配结果交给 Kimi 重排并给出可共创的方向描述。
# 不配置 MOONSHOT_API_KEY 时会自动退化为纯规则匹配。
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-turbo-preview

# 管理员（节点 id，逗号分隔）。这些 nf_member cookie 持有者可在任意创造者
# 详情页上传/更换头像。
# 例：ADMIN_NODE_IDS=4670a424-ffc5-4b5d-822e-36fc69ac0659
ADMIN_NODE_IDS=

# 邮箱魔法链接登录的签名密钥（≥16 位随机串）。强烈建议设置；不设置会回落到
# 由 SUPABASE_SERVICE_ROLE_KEY 派生，但每次轮换 service key 都会让旧链接失效。
# 例：AUTH_SECRET=$(openssl rand -hex 32)
AUTH_SECRET=

# 站点根 URL，用于在邮件里生成绝对登录链接。生产部署务必设置。
# 例：SITE_ORIGIN=https://nearby-forest.club
SITE_ORIGIN=
