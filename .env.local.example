# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# New Member Email Notification (optional)
# If RESEND_API_KEY is not set, email notifications are silently skipped.
# Sign up at https://resend.com to get a free API key.
RESEND_API_KEY=

# Comma-separated list of recipients. Defaults to 1826741794@qq.com if unset.
# Example: NOTIFY_EMAILS=host1@qq.com,host2@gmail.com
NOTIFY_EMAILS=

# Sender identity. Must be a verified domain in Resend, OR use the default
# 'onboarding@resend.dev' (only works for sending to yourself in the Resend account email).
# After verifying nearby-forest.club in Resend, switch to e.g.:
# NOTIFY_FROM=附近森林 <noreply@nearby-forest.club>
NOTIFY_FROM=

# DeepSeek 大模型（可选）
# 用于 AI 匹配、关键词提取，以及 phil-coach 真实对话。
# 不配置 DEEPSEEK_API_KEY 时，AI 匹配和关键词会尝试退化为旧 Kimi 配置或纯规则匹配。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Kimi (Moonshot) AI 匹配（旧配置，可选兜底）
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-turbo-preview

# 小芽 · AI 森林园丁（可选功能开关）
# 默认：小芽与静态知识检索开启；工具和反馈落库关闭。
# 设为 false 可同时关闭全站入口与服务端聊天接口。
XIAOYA_ENABLED=true
XIAOYA_RAG_ENABLED=true
XIAOYA_TOOLS_ENABLED=false
XIAOYA_FEEDBACK_ENABLED=false

# 管理员（节点 id，逗号分隔）。这些 nf_member cookie 持有者可在任意创造者
# 详情页上传/更换头像。
# 例：ADMIN_NODE_IDS=4670a424-ffc5-4b5d-822e-36fc69ac0659
ADMIN_NODE_IDS=

# 邮箱魔法链接登录的签名密钥（≥16 位随机串）。强烈建议设置；不设置会回落到
# 由 SUPABASE_SERVICE_ROLE_KEY 派生，但每次轮换 service key 都会让旧链接失效。
# 例：AUTH_SECRET=$(openssl rand -hex 32)
AUTH_SECRET=

# 站点根 URL，用于在邮件里生成绝对登录链接。生产部署务必设置。
# 例：SITE_ORIGIN=https://nearby-forest.club
SITE_ORIGIN=

# 语音（可选）：SiliconFlow API Key —— Qwen3-Omni 语音观察、
# SenseVoiceSmall 转写回退与 CosyVoice2 朗读共用
SILICONFLOW_API_KEY=

# ── 个人网站空间（src/lib/space/backend.ts、supabase-space.sql）──
# 空间数据存哪：不设时生产环境用 Supabase（space_rows / space_records / space_locks 三张表 + space-private 桶），开发环境用 .space-cache/ 里的文件
# SPACE_STORE=supabase
# 本地试 Supabase 那条路时，指到一个测试库（两个要一起设）；开发环境里不设这两个就连线上库会直接报错
# SPACE_SUPABASE_URL=http://127.0.0.1:54321
# SPACE_SUPABASE_SERVICE_ROLE_KEY=
# 真的要在开发环境连线上库时才设
# SPACE_ALLOW_PROD_FROM_DEV=1
# 新人注册、补完资料、第一次打开空间时自动让 AI 起稿：线上默认关，确认空间数据已在 Supabase 之后设 1
# SPACE_AUTO_DRAFT=1
# 开发环境里真的发空间相关的信（默认写进发件箱 outbox，不发）
# SPACE_MAIL=live

# ── PhilCoach 语音：阿里云百炼（DashScope，华北2 北京）流式「听 · 想 · 说」──
# 全部可选。没配百炼时（下面两个任一为空），所有语音路径、返回和界面都和原来完全一样。
# 用一个专用业务空间，里面只开通 qwen3-asr-flash-realtime 和 qwen-audio-3.1-tts-flash 两个模型。
# Key 只在服务端读，绝不进前端包（服务端识别、朗读都用它；它从不签发给浏览器的临时令牌，见下面 ASR_DIRECT）。
DASHSCOPE_API_KEY=
# 业务空间 ID（创建 Key 时弹窗里的 API Host，形如 ws-xxxx / llm-xxxx），会拼成 {ID}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_WORKSPACE_ID=
# 以下三项一般不用改
# DASHSCOPE_REGION=cn-beijing
# DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
# DASHSCOPE_TTS_MODEL=qwen-audio-3.1-tts-flash
# 百炼复刻得到的两把音色（voice_id，绑定 qwen-audio-3.1-tts-flash）。两把都配了，朗读的 auto 才会切到百炼
DASHSCOPE_TTS_VOICE_FEMALE=
DASHSCOPE_TTS_VOICE_MALE=
# 可选：百炼朗读的语气指令（自然语言）。不填用代码里的默认：轻柔、平稳、慢慢地说
# DASHSCOPE_TTS_INSTRUCTION=

# SiliconFlow CosyVoice2 的两把复刻嗓音（scripts/clone-phil-voice.mjs 得到的 speech:… URI）。
# 不配时朗读兜底到官方 anna 音色。百炼不可用、或开关切到 siliconflow 时用它们
PHIL_COACH_TTS_VOICE_FEMALE=
PHIL_COACH_TTS_VOICE_MALE=
# 可选：CosyVoice2 的语速，默认 0.9（稍慢，贴陪伴的语速）
# PHIL_COACH_TTS_SPEED=0.9

# 开关（都默认 auto）。想一键回退：把 *_PROVIDER 设成 siliconflow、STREAM_REPLY 设成 off，不用删 Key
# 听（定稿转写）：auto | bailian | siliconflow。auto = 配了百炼就用百炼，失败自动落回 SiliconFlow
# PHIL_COACH_ASR_PROVIDER=auto
# 浏览器直连百炼实时识别（边说边出字幕）：auto | off。off 时字幕和定稿都走服务端
# PHIL_COACH_ASR_DIRECT=auto
# 直连要交给浏览器一个 st- 临时令牌，它继承签发 Key 的全部权限——用上面那把签的话，
# 拿到令牌的人能直接调 TTS 用复刻嗓音合成任意文字、能列（按文档还能删）复刻音色（2026-10-28 实测）。
# 所以直连只用下面这把专用 Key 签：另开一个业务空间，里面只开通 qwen3-asr-flash-realtime，在那里建 Key。
# 两个都配齐、且和上面的 Key / 业务空间不同，auto 才会开直连；没配就整段上传，用户无感。
# 配好后跑 node scripts/check-asr-direct-key.mjs，确认这把 Key 签的令牌调不了 TTS 和复刻音色
# DASHSCOPE_ASR_DIRECT_API_KEY=
# DASHSCOPE_ASR_DIRECT_WORKSPACE_ID=
# 说（按句朗读 /api/phil-coach/speak）：auto | bailian | siliconflow。
# auto = 配了百炼 Key、Workspace 和上面两把百炼音色才用百炼，否则用 SiliconFlow 的 CosyVoice2
# PHIL_COACH_TTS_PROVIDER=auto
# 想（对话接口的流式回复）：auto | on | off。auto = 配了百炼才开
# PHIL_COACH_STREAM_REPLY=auto
# 可选：朗读分段签名密钥（≥16 位随机串）。不填就从 DASHSCOPE_API_KEY（没有则 SILICONFLOW_API_KEY）派生
# 例：PHIL_COACH_SPEECH_SIGNING_SECRET=$(openssl rand -hex 32)
# PHIL_COACH_SPEECH_SIGNING_SECRET=
